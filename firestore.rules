rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.organizer_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.organizer_id == request.auth.uid;
    }

    match /rsvps/{rsvpId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
  }
}
